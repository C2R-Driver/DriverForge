  {
    "id": "ne2k-probe",
    "case": {
      "devices": [
        "ne2k_pci,netdev=dpf-peer,mac=52:54:00:12:34:71,addr=5"
      ],
      "network_peer": {
        "expected_exchanges": []
      },
      "timeout_seconds": 180,
      "steps": [
        {
          "wait_serial": "# "
        },
        {
          "guest_assert": "printf '%s\\n' 'probe' > /proc/ne2k_test"
        },
        {
          "wait_serial": "DPF_NE2K_PUBLIC_OK probe"
