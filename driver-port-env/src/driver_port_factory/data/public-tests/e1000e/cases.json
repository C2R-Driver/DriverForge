[
  {
    "id": "e1000e-probe",
    "case": {
      "timeout_seconds": 180,
      "steps": [
        {
          "wait_serial": "# "
        },
        {
          "guest_assert": "printf '%s\\n' 'probe' > /proc/e1000e_test"
        },
        {
          "wait_serial": "DPF_INTEL_OK e1000e probe"
        }
      ],
      "acceptance": {
        "version": 2,
        "artifact": "same-final-iso",
        "guest_boot": {
          "wait_serial": "# ",
          "guest_assert": "sh /test/boot_hello.sh",
          "timeout_seconds": 180
        },
        "fixture": {
          "guest_assert": "printf '%s\n' 'probe' > /proc/e1000e_test",
          "wait_serial": "DPF_INTEL_OK e1000e probe"
        }
      }
    }
  },
  {
    "id": "e1000e-recovery",
    "case": {
      "timeout_seconds": 180,
      "steps": [
        {
          "wait_serial": "# "
        },
        {
          "guest_assert": "printf '%s\\n' 'recovery' > /proc/e1000e_test"
        },
        {
          "wait_serial": "DPF_INTEL_OK e1000e recovery"
        }
      ],
      "acceptance": {
        "version": 2,
        "artifact": "same-final-iso",
        "guest_boot": {
          "wait_serial": "# ",
          "guest_assert": "sh /test/boot_hello.sh",
          "timeout_seconds": 180
        },
        "fixture": {
          "guest_assert": "printf '%s\n' 'recovery' > /proc/e1000e_test",
          "wait_serial": "DPF_INTEL_OK e1000e recovery"
        },
        "traffic": {
          "case": "iperf3/tcp_virtio_bw",
          "guest_assert": "ip link show eth0",
          "guest_command": "/benchmark/common/bench_runner.sh iperf3/tcp_virtio_bw asterinas",
          "wait_serial": "The VM is ready for the benchmark.",
          "settle_seconds": 1,
          "host_command": "iperf3 -c $GUEST_SERVER_IP_ADDRESS -f m",
          "host_environment": {
            "GUEST_SERVER_IP_ADDRESS": "10.0.2.15"
          },
          "host_timeout_seconds": 55,
          "pass": {
            "host_exit_code": 0,
            "positive_mbits_roles": [
              "receiver",
              "sender"
            ]
          }
        }
      }
    }
  },
